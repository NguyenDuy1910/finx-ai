{
  "agents": {
    "default_timeout": 30,
    "max_retries": 3
  },
  "mcp": {
    "endpoint": "http://localhost:8080",
    "protocol_version": "1.0"
  },
  "atlassian": {
    "mcp_url": "https://mcp.atlassian.com/v1/mcp",
    "cloud_id": "",
    "default_space_id": "",
    "default_project_key": "",
    "timeout": 30,
    "enabled": true
  },
  "knowledge_base": {
    "vector_db": "qdrant",
    "embedding_model": "sentence-transformers",
    "chunk_size": 512,
    "overlap": 50
  },
  "qdrant": {
    "host": "localhost",
    "port": 6333,
    "grpc_port": 6334,
    "prefer_grpc": false,
    "api_key": null,
    "default_collection": "agent_knowledge",
    "vector_size": 384,
    "collections": {
      "conversations": {
        "name": "text2sql_conversations",
        "vector_size": 384,
        "distance": "Cosine"
      },
      "insights": {
        "name": "text2sql_insights",
        "vector_size": 384,
        "distance": "Cosine"
      },
      "sql_history": {
        "name": "text2sql_history",
        "vector_size": 384,
        "distance": "Cosine"
      },
      "confluence_knowledge": {
        "name": "confluence_knowledge",
        "vector_size": 384,
        "distance": "Cosine"
      },
      "finx_knowledge": {
        "name": "finx_knowledge",
        "vector_size": 1536,
        "distance": "Cosine"
      }
    }
  },
  "postgres": {
    "host": "localhost",
    "port": 5432,
    "database": "finx_db",
    "user": "finx_user",
    "password": "finx_password",
    "pool_size": 10,
    "max_overflow": 20
  },
  "prompts": {
    "temperature": 0.7,
    "max_tokens": 2000
  },
  "workflow": {
    "timeout_seconds": 120,
    "max_retries": 3,
    "enable_memory": true,
    "enable_async": true
  },
  "team_workflow": {
    "team_leader": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 1,
      "max_tokens": 30000,
      "description": "Orchestrates agents, writes final user-facing response with insights"
    },
    "knowledge_agent": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 1,
      "max_tokens": 2000,
      "description": "Schema retrieval and graph knowledge search — lightweight task"
    },
    "sql_generator_agent": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 0.0,
      "max_tokens": 10000,
      "description": "SQL generation requires precision — good coding model"
    },
    "chart_builder_agent": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 0.3,
      "max_tokens": 2000,
      "description": "Structured JSON chart specs — simple structured output task"
    },
    "schema_enricher": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 0.2,
      "max_tokens": 16000,
      "description": "Schema enrichment with AI-generated descriptions and knowledge graph"
    },
    "confluence_researcher": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 0.3,
      "max_tokens": 16000,
      "description": "Confluence deep-dive research — search, read, synthesize knowledge from Atlassian"
    },
    "kg_extractor": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 0.0,
      "max_tokens": 8000,
      "description": "Knowledge graph entity/relationship extraction from banking documents"
    },
    "kg_summarizer": {
      "provider": "9router",
      "model_id": "cx/gpt-5.4",
      "temperature": 0.0,
      "max_tokens": 2000,
      "description": "Summarize accumulated node/edge descriptions in knowledge graph"
    },
    "company_knowledge_agent": {
      "provider": "openai",
      "model_id": "gpt-4o-mini",
      "temperature": 0.2,
      "max_tokens": 4000,
      "description": "Company knowledge assistant — answers from Qdrant Confluence knowledge base with grounded citations"
    }
  }
}
