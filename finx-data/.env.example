# ── 9Router LLM ───────────────────────────────────────────────────────────────
# Base URL of the 9Router proxy (running locally)
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# API key that 9Router itself requires (set in 9Router's own config)
NINE_ROUTER_API_KEY=YOUR_9ROUTER_KEY
# Model ID — must match a model listed by GET /v1/models on your 9Router instance.
# 9Router uses a "cx/" prefix for its internal model pool, e.g.:
#   cx/gpt-5.1          — GPT-5.1 (recommended for extraction tasks)
#   cx/gpt-5.1-codex    — GPT-5.1 Codex variant
#   cx/gpt-5.3-codex    — GPT-5.3 Codex (highest quality, slower)
# Do NOT use "default" or bare OpenAI model names — 9Router will try to forward
# them directly to OpenAI and fail with "No credentials for provider: openai".
NINE_ROUTER_MODEL=cx/gpt-5.4

# ── AWS Athena (for route_schema.py live mode) ───────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ATHENA_DATABASE=finance
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/

# ── Confluence (for route_confluence.py) ──────────────────────────────────────
CONFLUENCE_URL=https://your-org.atlassian.net
CONFLUENCE_USERNAME=your@email.com
CONFLUENCE_API_TOKEN=
# Space(s) to crawl — comma-separated (default: DATA)
CONFLUENCE_SPACE_KEYS=DATA,FINANCE
# Optional: process a single page instead of crawling a space
# CONFLUENCE_PAGE_URL=https://your-org.atlassian.net/wiki/spaces/DATA/pages/123456789

# ── Pipeline settings ─────────────────────────────────────────────────────────
OUTPUT_DIR=output
LOG_LEVEL=INFO
